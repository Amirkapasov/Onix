# Скопируйте в .env и заполните. .env не коммитится.

# LLM: Gemini (Google AI Studio / Gemini API)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBED_MODEL=

# Данные
TWOGIS_API_KEY=
POIS_PATH=data/pois.json

# Маршруты: публичный OSRM для пешеходов, при недоступности — оценка по прямой ×1.3
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
