# Скопируйте в .env и заполните. .env не коммитится.

# LLM: финальный провайдер — gemini; claude/openai можно использовать в разработке
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBED_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=

# Данные
TWOGIS_API_KEY=
POIS_PATH=data/pois.json

# Маршруты: публичный OSRM для пешеходов, при недоступности — оценка по прямой ×1.3
OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
